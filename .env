# GFBio Webhook Environment Configuration

# Rust Logging Level
RUST_LOG=info

# GFBio API Configuration
GFBIO_BASE_URL=https://transformation.gfbio.org/api

# Aruna Webhook Configuration
ARUNA_BASE_URL="https://aruna-engine.org"
ARUNA_SERVER_ADDRESS=http://server:50051

# Server Configuration
SERVER_HOST=0.0.0.0
SERVICE_PORT=5000

# File Storage
TEMP_DIR=/app/temp
MAX_FILE_SIZE=52428800

# Security
CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# Health Check
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# Docker specific
CONTAINER_NAME=abcd_webhooker
NETWORK_NAME=abcd_network